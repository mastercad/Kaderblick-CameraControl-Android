<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/grey_background"
    tools:context=".MainActivity">

    <!-- Connection Panel -->
    <LinearLayout
        android:id="@+id/connectionPanel"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="16dp"
        android:background="@color/black"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <EditText
            android:id="@+id/cameraIpInput"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:hint="@string/camera_ip_hint"
            android:inputType="text"
            android:textColor="@color/white"
            android:textColorHint="@color/white"
            android:padding="12dp" />

        <Button
            android:id="@+id/connectButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/connect"
            android:layout_marginStart="8dp"
            app:backgroundTint="@color/kaderblick_primary" />
    </LinearLayout>

    <!-- Status Text -->
    <TextView
        android:id="@+id/statusText"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="@string/status_disconnected"
        android:textColor="@color/white"
        android:textSize="14sp"
        android:padding="8dp"
        android:gravity="center"
        app:layout_constraintTop_toBottomOf="@id/connectionPanel"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Dual Camera Preview Container -->
    <LinearLayout
        android:id="@+id/cameraPreviewContainer"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:orientation="vertical"
        android:background="@color/black"
        app:layout_constraintTop_toBottomOf="@id/statusText"
        app:layout_constraintBottom_toTopOf="@id/cameraSelector"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- Camera 1 Preview -->
        <FrameLayout
            android:id="@+id/camera1Container"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:layout_margin="4dp">

            <androidx.camera.view.PreviewView
                android:id="@+id/camera1Preview"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/camera_1"
                android:textColor="@color/white"
                android:background="#80000000"
                android:padding="8dp"
                android:layout_gravity="top|start"
                android:layout_margin="8dp" />
        </FrameLayout>

        <!-- Camera 2 Preview -->
        <FrameLayout
            android:id="@+id/camera2Container"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:layout_margin="4dp">

            <androidx.camera.view.PreviewView
                android:id="@+id/camera2Preview"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/camera_2"
                android:textColor="@color/white"
                android:background="#80000000"
                android:padding="8dp"
                android:layout_gravity="top|start"
                android:layout_margin="8dp" />
        </FrameLayout>
    </LinearLayout>

    <!-- Camera Selector -->
    <RadioGroup
        android:id="@+id/cameraSelector"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="8dp"
        android:gravity="center"
        android:background="@color/black"
        app:layout_constraintBottom_toTopOf="@id/controlPanel"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <RadioButton
            android:id="@+id/selectCamera1"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/camera_1"
            android:textColor="@color/white"
            android:checked="true"
            android:layout_marginEnd="16dp" />

        <RadioButton
            android:id="@+id/selectCamera2"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/camera_2"
            android:textColor="@color/white"
            android:layout_marginEnd="16dp" />

        <RadioButton
            android:id="@+id/selectBothCameras"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/dual_camera_mode"
            android:textColor="@color/white" />
    </RadioGroup>

    <!-- Control Panel -->
    <LinearLayout
        android:id="@+id/controlPanel"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="16dp"
        android:gravity="center"
        android:background="@color/black"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <Button
            android:id="@+id/captureButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/capture_photo"
            android:layout_margin="4dp"
            android:enabled="false"
            app:backgroundTint="@color/kaderblick_accent" />

        <Button
            android:id="@+id/recordButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/start_recording"
            android:layout_margin="4dp"
            android:enabled="false"
            app:backgroundTint="@color/kaderblick_secondary" />

        <Button
            android:id="@+id/switchCameraButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/switch_camera"
            android:layout_margin="4dp"
            android:enabled="false"
            app:backgroundTint="@color/kaderblick_primary" />
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
