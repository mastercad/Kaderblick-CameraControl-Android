<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="320dp"
    android:layout_height="wrap_content"
    android:background="#CC111111"
    android:padding="12dp">

    <LinearLayout
        android:id="@+id/controls_root"
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <!-- Fixierter Header – immer sichtbar, auch wenn Inhalt darunter scrollt -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/controls_title"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:text="Camera Controls"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:padding="4dp" />

            <Button
                android:id="@+id/btnResetAll"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Reset"
                style="?android:attr/buttonStyleSmall" />

            <Button
                android:id="@+id/btnCloseControls"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="✕"
                style="?android:attr/buttonStyleSmall" />

        </LinearLayout>

        <!-- Gesamter scrollbarer Inhalt -->
        <ScrollView
            android:id="@+id/controls_main_scroll"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp">

            <LinearLayout
                android:orientation="vertical"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <!-- Schnell-Einstellungen: Auflösung -->
                <LinearLayout
                    android:id="@+id/controls_quick_section"
                    android:orientation="vertical"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" />

                <!-- Kamera-Bildeinstellungen (Kontrast, Gain, etc.) -->
                <LinearLayout
                    android:id="@+id/controls_container"
                    android:orientation="vertical"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" />

                <!-- Preset-Sektion -->
                <LinearLayout
                    android:id="@+id/controls_preset_section"
                    android:orientation="vertical"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp" />

                <!-- Joystick / Steuerung (Y-Achse invertieren) -->
                <LinearLayout
                    android:id="@+id/controls_joystick_section"
                    android:orientation="vertical"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp" />

            </LinearLayout>
        </ScrollView>

    </LinearLayout>

</FrameLayout>